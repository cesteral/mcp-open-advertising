# Development environment configuration

# Project configuration
project_id  = "YOUR_GCP_PROJECT_DEV"
region      = "europe-west2"
environment = "dev"

# Container images, keyed by package (scripts/deploy.sh and Cloud Build pass
# the real ones; these are placeholders)
mcp_images = {
  "dbm-mcp"        = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_DEV/cesteral/dbm-mcp:latest"
  "dv360-mcp"      = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_DEV/cesteral/dv360-mcp:latest"
  "ttd-mcp"        = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_DEV/cesteral/ttd-mcp:latest"
  "gads-mcp"       = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_DEV/cesteral/gads-mcp:latest"
  "meta-mcp"       = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_DEV/cesteral/meta-mcp:latest"
  "linkedin-mcp"   = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_DEV/cesteral/linkedin-mcp:latest"
  "tiktok-mcp"     = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_DEV/cesteral/tiktok-mcp:latest"
  "cm360-mcp"      = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_DEV/cesteral/cm360-mcp:latest"
  "snapchat-mcp"   = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_DEV/cesteral/snapchat-mcp:latest"
  "sa360-mcp"      = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_DEV/cesteral/sa360-mcp:latest"
  "pinterest-mcp"  = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_DEV/cesteral/pinterest-mcp:latest"
  "amazon-dsp-mcp" = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_DEV/cesteral/amazon-dsp-mcp:latest"
  "msads-mcp"      = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_DEV/cesteral/msads-mcp:latest"
}

# Networking
create_vpc             = true
serverless_subnet_cidr = "10.8.0.0/28"

# VPC connector - smaller for dev
connector_machine_type   = "e2-micro"
connector_min_instances  = 2
connector_max_instances  = 3
connector_min_throughput = 200
connector_max_throughput = 300

# Cloud NAT
enable_nat_logging                  = true
nat_log_filter                      = "ALL" # More verbose logging in dev
nat_min_ports_per_vm                = 64
enable_endpoint_independent_mapping = false

# Cloud Run - conservative scaling for dev
min_instances         = 0 # Scale to zero in dev
max_instances         = 1 # Pinned to 1 (sessions are per instance) until stateless MCP, #243
cpu_limit             = "1"
memory_limit          = "512Mi"
cpu_always_allocated  = false
allow_unauthenticated = false # Cloud Run IAM required; the governance app presents a Google ID token
# The governance app (cesteral-intelligence) calls the fleet with a Cloud Run ID
# token minted via Vercel WIF for the governance-invoker SA. Grant that SA
# roles/run.invoker on every service. Cross-project member is valid (SA lives in
# the cesteral-governance project). Source the SA email from the governance
# identity stack: `terraform output governance_invoker_email`.
#
# ORDERING: apply the governance identity stack (cesteral-intelligence/terraform)
# BEFORE this one — the IAM grant below fails at apply time if the SA doesn't
# exist yet. Until then, deploy with allow_unauthenticated = true and an empty
# authorized_invokers list. deploy.sh's health gate handles either mode (it
# falls back to the deployer's identity token on 401/403).
authorized_invokers = ["serviceAccount:governance-invoker@cesteral-governance.iam.gserviceaccount.com"]

# MCP Server configuration
log_level             = "debug" # More verbose logging in dev
governance_token_mode = "warn"  # off | warn | enforce — verify+log decision tokens without blocking
# Shared decision-token signing secret (verify side). The secret container is
# provisioned out-of-band (shared with the governance layer's mint side) and
# must already hold a version before apply — the name here must match it.
governance_token_secret_name = "governance-decision-token-secret"
# Set only while a key rotation is in flight (referenced secret must have a version):
# governance_token_secret_previous_name = "governance-decision-token-secret-previous"
# Shared MRTR requestState sealing key (MCP_REQUEST_STATE_SECRET, >= 32 chars).
# Provisioned out-of-band like the decision-token secret; it must already hold a
# version before apply. Every instance needs the same value.
request_state_secret_name = "mcp-request-state-secret"
# Stage proven contracts into enforce while the fleet mode stays warn, e.g.:
# governance_token_enforce_contracts = ["meta.update_budget.v1", "google_ads.pause_entity.v1"]
enable_gcs_persistence = false
gcs_bucket_name        = "YOUR_GCP_PROJECT_DEV-mcp-persistence" # Enable when ready

# Artifact Registry
artifact_registry_repo_name = "YOUR_REGISTRY"

# Monitoring
monitoring_notification_email = "your-email@example.com"

# Fleet load balancer (optional) — serves every MCP server under one custom
# domain with path-based routing: https://<fleet_domain>/<platform>/mcp.
# After first apply, create a DNS-only A record for fleet_domain pointing at
# the fleet_lb_ip output; the Google-managed certificate provisions once DNS
# resolves to the LB (15-60 min). Unmatched paths redirect to
# fleet_redirect_host (default cesteral.com).
# enable_fleet_lb = true
# fleet_domain    = "mcp.example.com"
