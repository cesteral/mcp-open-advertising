# Production environment configuration

# Project configuration
project_id  = "YOUR_GCP_PROJECT_PROD"
region      = "europe-west2"
environment = "prod"

# Container images, keyed by package (scripts/deploy.sh and Cloud Build pass
# the real ones; these are placeholders)
mcp_images = {
  "dbm-mcp"        = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_PROD/cesteral/dbm-mcp:latest"
  "dv360-mcp"      = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_PROD/cesteral/dv360-mcp:latest"
  "ttd-mcp"        = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_PROD/cesteral/ttd-mcp:latest"
  "gads-mcp"       = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_PROD/cesteral/gads-mcp:latest"
  "meta-mcp"       = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_PROD/cesteral/meta-mcp:latest"
  "linkedin-mcp"   = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_PROD/cesteral/linkedin-mcp:latest"
  "tiktok-mcp"     = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_PROD/cesteral/tiktok-mcp:latest"
  "cm360-mcp"      = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_PROD/cesteral/cm360-mcp:latest"
  "snapchat-mcp"   = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_PROD/cesteral/snapchat-mcp:latest"
  "sa360-mcp"      = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_PROD/cesteral/sa360-mcp:latest"
  "pinterest-mcp"  = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_PROD/cesteral/pinterest-mcp:latest"
  "amazon-dsp-mcp" = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_PROD/cesteral/amazon-dsp-mcp:latest"
  "msads-mcp"      = "europe-west2-docker.pkg.dev/YOUR_GCP_PROJECT_PROD/cesteral/msads-mcp:latest"
}

# Networking
create_vpc             = true
serverless_subnet_cidr = "10.8.0.0/28"

# VPC connector - robust for production
connector_machine_type   = "e2-micro"
connector_min_instances  = 2
connector_max_instances  = 10
connector_min_throughput = 300
connector_max_throughput = 1000

# Cloud NAT
enable_nat_logging                  = true
nat_log_filter                      = "ERRORS_ONLY"
nat_min_ports_per_vm                = 64
enable_endpoint_independent_mapping = true # Better for production

# Cloud Run - production scaling
min_instances         = 1   # Always keep 1 warm
max_instances         = 1   # Pinned to 1 (sessions are per instance) until stateless MCP, #243
cpu_limit             = "2" # More CPU for production
memory_limit          = "1Gi"
cpu_always_allocated  = true # Faster response times
allow_unauthenticated = false

# MCP Server configuration
log_level             = "info" # Production logging level
governance_token_mode = "warn" # off | warn | enforce — verify+log decision tokens without blocking; stage to enforce per-contract once parity is confirmed
# Shared decision-token signing secret (verify side). UNCOMMENT ONLY AFTER the
# prod secret container holds a version — Cloud Run revision deploys fail when
# the referenced secret is empty. Dev-first rollout: wire dev, observe warn-mode
# verdicts, then set the prod value and uncomment here.
# governance_token_secret_name = "governance-decision-token-secret"
# Set only while a key rotation is in flight (referenced secret must have a version):
# governance_token_secret_previous_name = "governance-decision-token-secret-previous"
# Shared MRTR requestState sealing key (MCP_REQUEST_STATE_SECRET, >= 32 chars).
# UNCOMMENT ONLY AFTER the prod secret holds a version. Provisioned out-of-band like the decision-token secret; it must already hold a
# version before apply. Every instance needs the same value.
# request_state_secret_name = "mcp-request-state-secret"
# Stage proven contracts into enforce while the fleet mode stays warn, e.g.:
# governance_token_enforce_contracts = ["meta.update_budget.v1", "google_ads.pause_entity.v1"]
enable_gcs_persistence = false
gcs_bucket_name        = "YOUR_GCP_PROJECT_PROD-mcp-persistence" # Enable when ready

# Artifact Registry
artifact_registry_repo_name = "YOUR_REGISTRY"

# Monitoring
monitoring_notification_email = "your-email@example.com"

# Per-service resource overrides (heavy reporting server gets more resources)
service_resource_overrides = {
  "dbm-mcp" = {
    cpu_limit     = "2"
    memory_limit  = "1Gi"
    max_instances = 1
  }
}

# Fleet load balancer (optional) — see dev.tfvars.example for details.
# enable_fleet_lb = true
# fleet_domain    = "mcp.example.com"
