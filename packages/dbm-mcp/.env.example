# DBM MCP Server Configuration (DV360 Reporting)

# Server
DBM_MCP_PORT=3001
DBM_MCP_HOST=127.0.0.1
NODE_ENV=development

# Auth mode: google-headers (default), jwt, none
MCP_AUTH_MODE=google-headers

# JWT auth (only for jwt mode)
# MCP_AUTH_SECRET_KEY=your-secret-key

# Google Cloud
# GCP_PROJECT_ID=your-project-id

# Stdio mode credentials (choose one)
# SERVICE_ACCOUNT_FILE=/path/to/service-account.json
# SERVICE_ACCOUNT_JSON=base64-encoded-json

# Rate Limiting
# Leave unset to use the default (10/min per process). No published quota backs a
# higher value — see dbm.rate_limit_default in platform-facts.json before raising.
# The unprefixed RATE_LIMIT_PER_MINUTE is still read when this is unset.
# DBM_RATE_LIMIT_PER_MINUTE=10

# Report Polling (async Bid Manager reports)
# REPORT_CACHE_TTL_MS=300000
# REPORT_POLL_MAX_RETRIES=10
# REPORT_POLL_INITIAL_DELAY_MS=2000
# REPORT_POLL_MAX_DELAY_MS=60000
# REPORT_QUERY_RETRIES=3
# REPORT_RETRY_COOLDOWN_MS=60000
# Wall-time cap on one synchronous report run (create, run, poll, retries).
# The default (240000) stops before Cloud Run's default 300 s request timeout;
# dbm_run_custom_query_async is not capped by it.
# REPORT_SYNC_MAX_WALL_TIME_MS=240000

# Session Management
# MCP_STATEFUL_SESSION_TIMEOUT_MS=3600000

# CORS
# MCP_ALLOWED_ORIGINS=https://app.example.com
# DNS-rebinding protection for /mcp (#241). Unset: on a loopback bind (the
# default host outside NODE_ENV=production) only localhost / 127.0.0.1 / [::1]
# Host headers are accepted, and an Origin must be a loopback origin unless
# MCP_ALLOWED_ORIGINS is set; on any other bind Host is not checked. Set a
# comma-separated list to enforce Host on any bind (an entry with :port must
# match exactly, one without matches any port).
# MCP_ALLOWED_HOSTS=mcp.example.com

# Logging
LOG_LEVEL=info
# MCP_LOG_LEVEL=debug

# OpenTelemetry (optional)
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=dbm-mcp
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics

# GCS Persistence (optional)
# GCS_BUCKET_NAME=your-bucket-name
