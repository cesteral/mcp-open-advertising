{
  "name": "@cesteral/shared",
  "version": "1.2.0",
  "description": "Shared infrastructure utilities and authentication for Cesteral MCP servers",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cesteral/mcp-open-advertising.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/cesteral/mcp-open-advertising#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "advertising",
    "shared",
    "utilities"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    }
  },
  "scripts": {
    "prebuild": "node ../../scripts/generate/sync-registry-data.mjs",
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cesteral/contract-hash": "workspace:*",
    "@cesteral/contract-schema": "workspace:*",
    "@google-cloud/firestore": "^9.4.0",
    "@google-cloud/opentelemetry-cloud-monitoring-exporter": "^0.20.0",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^2.0.0",
    "@google-cloud/storage": "^8.4.0",
    "@hono/mcp": "^0.2.3",
    "@hono/node-server": "^2.1.8",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "dotenv": "^18.0.10",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "pino": "catalog:",
    "pino-pretty": "^13.2.0",
    "zod": "catalog:",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0"
  }
}
