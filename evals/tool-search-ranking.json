  "gaps": [
    {
      "server": "dv360-mcp",
      "platform": "dv360",
      "query": "permanently remove a campaign",
      "wanted": "dv360_delete_entity",
      "actualTop": "dv360_get_pacing_status",
      "wantedNotInTopN": 4,
      "note": "SYNONYM GAP. The ranker is purely lexical: 'remove' shares no token with 'delete', so the delete tool collapses to score 1 while an unrelated read tool wins. Swap 'remove' for 'delete' and dv360_delete_entity is #1. Recorded so the gap is auditable, NOT endorsed."
    },
    {
      "server": "ttd-mcp",
      "platform": "ttd",
      "query": "permanently remove a campaign",
      "wanted": "ttd_delete_entity",
      "actualTop": "ttd_get_pacing_status",
      "wantedNotInTopN": 4,
      "note": "Same synonym gap as dv360, on a second server — evidence it is a property of the ranker, not of one server's wording."
    },
    {
      "server": "dv360-mcp",
      "platform": "dv360",
      "query": "remove this line item permanently",
      "wanted": "dv360_delete_entity",
      "actualTop": "dv360_adjust_line_item_bids",
      "wantedNotInTopN": 6,
      "note": "The safety case #205 asks about, and it is worse than the issue guessed. A bid-adjustment tool wins because 'line' and 'item' each hit its name for +5; the delete tool never surfaces. Both of dv360's irreversible paths (delete, and archive via bulk_update_status) are terminal per #201, and no single query puts them together near the top."
    },
    {
      "server": "tiktok-mcp",
      "platform": "tiktok",
      "query": "delete an ad group",
      "wanted": "tiktok_delete_entity",
      "actualTop": "tiktok_adjust_bids",
      "wantedNotInTopN": 1,
      "note": "THE 2-CHARACTER SUBSTRING EDGE the issue predicted, demonstrated live. Name matching is substring-either-direction, so the query token 'ad' matches 'adjust' inside tiktok_adjust_bids and buys it the full +5 name weight. tiktok_delete_entity is #2."
    },
    {
      "server": "msads-mcp",
      "platform": "msads",
      "query": "delete a campaign",
      "wanted": "msads_delete_entity",
      "actualTop": "msads_delete_report_schedule",
      "wantedNotInTopN": 1,
      "note": "Deleting a report SCHEDULE outranks deleting the campaign, because the extra 'report'/'schedule' tokens pick up description hits. cm360 has the same two tools and gets it the right way round, so this is wording drift rather than an inevitability."
    },
    {
      "server": "amazon-dsp-mcp",
      "platform": "amazon_dsp",
      "query": "delete a campaign",
      "wanted": "amazon_dsp_delete_entity",
      "actualTop": "amazon_dsp_get_campaign_forecast",
      "wantedNotInTopN": 1,
      "note": "A read-only forecasting tool outranks the delete tool for an explicit delete query, on the strength of 'campaign' appearing in its name. amazon_dsp_delete_entity is #2."
    }
  ]
