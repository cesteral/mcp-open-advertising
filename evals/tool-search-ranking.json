    {
      "server": "tiktok-mcp",
      "platform": "tiktok",
      "query": "upload a video creative",
      "expectTop": "tiktok_upload_video",
      "outranks": ["tiktok_upload_image"],
      "note": "Pins that video beats image for a video query — the two differ by one name token and share most of their description."
