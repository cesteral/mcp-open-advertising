    {
      "server": "ttd-mcp",
      "platform": "ttd",
      "query": "archive a campaign",
      "expectTop": "ttd_archive_entities",
      "note": "TTD is the one server whose archive path has 'archive' in the tool name, so the lexical ranker finds it. Contrast dv360, whose archive path is bulk_update_status — see gaps."
    }
